/*** BUSQUEDA DE TEMAS Y MENSAJES ***/

.paginasao {
    display: flex;
    justify-content: center;
    font-size: 16px;
    line-height: 100%;
    margin: 20px;
}

.search.post.row1 {
    background: var(--fondo3);
    border: var(--borde2);
    padding: 5px;
    margin: 10px;
    margin-top: 35px;
}

.search.post.row1 h2.h3 a {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 15px 20px 5px;
    box-sizing: border-box;
    position: relative;
    padding-bottom: 10px;
    font-size: 15px;
    color: var(--textobase);
}

.search.post.row1 h2.h3 a:after {
    content: ' ';
    position: absolute;
    left: 0px;
    bottom: -3px;
    height: 3px;
    width: 100%;
    background: var(--gradient1);
    border-radius: 3px;
}

.headbusca {
display: flex;
    margin: 10px;
    border: var(--borde2);
    height: 100px;
}

.hb-icon {
width: 10%;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--color1);
    font-size: 35px;
    background: var(--fondo1);
    border-right: var(--borde2);
    box-sizing: border-box;
}

.hb-info {
    width: 90%;
    background: var(--fondo3);
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    padding-left: 50px;
}

.hb-i1 {
font-size: 20px;
    font-weight: 800;
    line-height: 100%;
    color: transparent;
    background: var(--gradient1);
    width: fit-content;
    background-clip: text;
    margin-bottom: 5px;
}

.hb-i2 {
    text-transform: uppercase;
    font-size: 12px;
}

.rowt1-03 {
display: flex;
    flex-direction: column;
    width: 30%;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    text-transform: uppercase;
    gap: 3px;
}

.rowt1-3-1 {
    font-weight: 600;
}

.rowt1-3-2 {
    font-size: 13px;
}

.rowt1-02 {
width: 10%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.rowt1-2k {
    margin: 5px;
    font-size: 14px;
    margin-left: -5px;
}

.rowt1-2k i {
    color: var(--color1);
    font-size: 12px;
    margin-right: 5px;
}

.rowt1-1-3 span.page-sep {
    display: none!important;
}

.rowti-icon {
    width: 25px;
    margin: 14px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-transform: uppercase;
    height: 25px;
}

.rowt1-01 {
flex: 1;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    position: relative;
    justify-content: center;
    padding-left: 25px;
}

.rowt1-1-1 a {
text-transform: lowercase;
    font-style: italic;
    font-weight: 800;
    font-size: 18px;
    color: var(--links1);
}

.rowt1-1-2 {
    margin-top: 7px;
}

.rowt1-1-2 i {
    color: var(--color1);
}

.rowt1-1-2 a {
text-transform: uppercase;
    font-weight: 600;
    color: var(--textobase);
    font-size: 11px;
    font-style: italic;
    opacity: .7;
}

.rowt1-1-3 {
    position: absolute;
    right: 15px;
    top: 20px;
    width: 200px;
}

.rowt1-1-3 .pagination span {
    display: flex;
}

.rowt1-1-3 .pagination span a {
    border: none;
    width: 15px;
    height: 15px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--links2);
    font-size: 11px;
    font-weight: 600;
    line-height: 100%;
    padding: 0px;
    padding: 3px;
    border-radius: 100%;
    background: var(--color1);
    margin: 2px;
}

.rowti {
background: var(--fondo2);
    margin: 5px 10px 11px;
    height: 75px;
    border: var(--borde2);
    display: flex;
    align-items: center;
}
